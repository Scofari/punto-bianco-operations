{
  "name": "punto-bianco-operations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests docs README.md next.config.ts package.json tsconfig.json eslint.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --env-file=.env.local tests/workflow.integration.ts",
    "test:access": "tsx --env-file=.env.local tests/data-access.integration.ts",
    "test:load": "tsx --env-file=.env.local tests/load.integration.ts",
    "test:browser": "node --env-file=.env.local tests/browser-workflow.mjs",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "0.577.0",
    "next": "16.4.4",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.4",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
