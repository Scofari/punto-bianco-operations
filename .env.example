SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres
APP_URL=http://localhost:3000
DEMO_PASSWORD=choose-a-strong-password-before-running-seed
